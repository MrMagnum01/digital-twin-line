# local environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
# generated data / results - never committed (dev-seed output only, locally)
out/
# runner.cli's own exclusive per-run artifacts (default --run-dir target)
runs/
*.duckdb
*.duckdb.wal
*.npz
*.csv
*.parquet
# schema is source, not data (overrides any broader *.sql ignore)
!src/schema.sql
!monitoring/schema.sql
